#pragma once

// PLUGIN_VERSION comes from euroscope-plugin/CMakeLists.txt PROJECT(... VERSION ...).
// It is not tied to the MSI / common package version.

namespace {
const char *PLUGIN_NAME{ "VatEFS" };
const char *PLUGIN_VERSION{ "@VATEFS_PLUGIN_VERSION_STRING@" };
const char *PLUGIN_AUTHOR{ "Martin Insulander" };
const char *PLUGIN_LICENSE{ "GPLv3" };

static constexpr std::uint8_t PLUGIN_VERSION_MAJOR = @CMAKE_PROJECT_VERSION_MAJOR@;
static constexpr std::uint8_t PLUGIN_VERSION_MINOR = @CMAKE_PROJECT_VERSION_MINOR@;
static constexpr std::uint8_t PLUGIN_VERSION_PATCH = @CMAKE_PROJECT_VERSION_PATCH@;
}